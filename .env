# 前端请求的默认api前缀
VITE_API_BASE_URL="/api"

# 用户登录后会话的有效期配置（单位：毫秒）
# 根据用户剩余登录次数动态设置会话时长

# 剩余登录次数 = 1 时的会话时长（3分钟）
VITE_SESSION_DURATION_LEVEL_1=180000
SESSION_DURATION_LEVEL_1=180000

# 剩余登录次数 > 1 且 <= 5 时的会话时长（8分钟）
VITE_SESSION_DURATION_LEVEL_2=480000
SESSION_DURATION_LEVEL_2=480000

# 剩余登录次数 > 5 且 <= 30 时的会话时长（20分钟）
VITE_SESSION_DURATION_LEVEL_3=1200000
SESSION_DURATION_LEVEL_3=1200000

# 剩余登录次数 > 30 时的会话时长（24小时）
VITE_SESSION_DURATION_LEVEL_4=86400000
SESSION_DURATION_LEVEL_4=86400000

# 默认会话时长（用于向后兼容，实际将根据用户剩余登录次数动态设置）
VITE_SESSION_DURATION=360000 # 6 * 60 * 1000 = 6分钟
SESSION_DURATION=360000 # 后端使用的默认会话时长

# 后端服务器配置
PORT=20000 # 服务器监听端口

# 数据库配置
DB_HOST=localhost # 数据库主机地址
DB_USER=root 
DB_PASSWORD=991218aa
DB_NAME=degree_management # 数据库名称
DB_PORT=3306 # 数据库端口

# IP黑名单配置（逗号分隔多个 IP地址）
# 此配置用于手动添加永久或长期黑名单IP，系统启动时会加载这些IP到数据库
IP_BLACKLIST=103.151.173.208,183.6.9.103,222.120.184.140,222.120.184.141,103.151.173.206,103.151.173.197

# IP频率检测与自动封禁配置
IP_RATE_LIMIT_WINDOW=300000          # 频率检测时间窗口（毫秒），默认5分钟
IP_RATE_LIMIT_MAX_REQUESTS=10        # 时间窗口内最大请求次数，超过则封禁
IP_RATE_LIMIT_BLOCK_DURATION=604800000  # 自动封禁时长（毫秒），默认7天
IP_RATE_LIMIT_CLEANUP_INTERVAL=3600000  # 缓存清理间隔（毫秒），默认1小时

# 数据库连接池配置
DB_CONNECTION_LIMIT=10 # 连接池最大连接数
DB_QUEUE_LIMIT=5 # 等待队列限制
DB_WAIT_FOR_CONNECTIONS=true # 是否等待可用连接
DB_CONNECT_TIMEOUT=10000 # 连接超时时间(毫秒)
DB_ACQUIRE_TIMEOUT=60000 # 等待超时时间(毫秒)
DB_TIMEOUT=60000 # 查询超时时间(毫秒)

# 数据库监控配置
DB_HEALTH_CHECK_INTERVAL=18000000  # 5小时检查一次 (5 * 60 * 60 * 1000)
DB_STATUS_REPORT_INTERVAL=18000000 # 5小时报告一次状态
DB_TIMEZONE=+08:00

# JWT 密钥
JWT_SECRET=edit_my_degree_secret_key

# 后端JWT Token过期时间配置
JWT_EXPIRES_IN=10m # 普通用户Token过期时间，默认10分钟
SUPERADD_JWT_EXPIRES_IN=30d # 超级管理员Token过期时间，默认30天

# API签名密钥
API_SECRET_KEY=edit_my_degree_api_secret_key
VITE_API_SECRET_KEY=edit_my_degree_api_secret_key # 前端签名密钥，必须与API_SECRET_KEY保持一致

# 应用标识配置
VITE_APP_KEY=sadwgfsefsdgfsdgf # 前端应用身份标识，必须在VALID_APP_KEYS白名单中
VALID_APP_KEYS=sadwgfsefsdgfsdgf,asddsdoaiwd_asdlawnnn,zczxcvbnm123456

# 二维码扫码后跳转验证界面的服务器 URL
VERIFICATION_BASE_URL=http://cheerout.cn:9092

# PDF 二维码生成模式配置
# available: 生成正常验证二维码 (使用 VERIFICATION_BASE_URL)
# maintenance: 显示维护信息 (不生成有效二维码)
PDF_QR_CODE_MODE=available

# MinIO 配置项
# 新的minio服务搭建好后需要设置一下mc 给服务器起个小名，运行: mc alias set minio http://127.0.0.1:19000 zxx 991218aa
# 然后给桶的权限设置为公开：mc anonymous set public myminio/editmydegree
MINIO_ENDPOINT=cheerout.cn:19000          # MinIO 服务器地址（格式：主机名：端口）
MINIO_BUCKET=editmydegree                 # 存储桶名称
MINIO_ACCESS_KEY=zxx            # ⚠️ 必须替换为实际的 Access Key
MINIO_SECRET_KEY=991218aa          # ⚠️ 必须替换为实际的 Secret Key
MINIO_USE_SSL=false                       # 是否使用 SSL（true/false）

# =========================purchase.tsx页面配置===============================

# 四云发卡网-卡密购买链接
VITE_CARD_LOGIN_URL=http://4ox.cn/bq3kuv # 登录卡密下单链接
VITE_CARD_PDF_URL=http://4ox.cn/sdms3r # PDF下单链接

# QQ 群号
VITE_QQ_GROUP=1034981273
# ============================================================================

# 点击查看验证报告后验证报告模块开关配置
# true: 正常显示验证报告页面
# false: 显示维护提示页面
VITE_REPORT_IS_OPEN=true
