# 前端配置
VITE_API_BASE_URL="/api"
# 用户登录后会话的有效期，单位毫秒
VITE_SESSION_DURATION=600000 # 10秒 * 60 * 1000 = 10分钟
VITE_API_SECRET_KEY=edit_my_degree_api_secret_key

# 后端服务器配置
PORT=20000 # 服务器监听端口
VITE_APP_KEY = "sadwgfsefsdgfsdgf" # 登录会话的密钥

# 数据库配置
DB_HOST=localhost # 数据库主机地址
DB_USER=root 
DB_PASSWORD=991218aa
DB_NAME=degree_management # 数据库名称
DB_PORT=3306 # 数据库端口

# 数据库连接池配置
DB_CONNECTION_LIMIT=10 # 连接池最大连接数
DB_QUEUE_LIMIT=0 # 等待队列限制
DB_WAIT_FOR_CONNECTIONS=true # 是否等待可用连接
DB_CONNECT_TIMEOUT=10000 # 连接超时时间(毫秒)
DB_ACQUIRE_TIMEOUT=60000 # 等待超时时间(毫秒)
DB_TIMEOUT=60000 # 查询超时时间(毫秒)

# 数据库监控配置
DB_HEALTH_CHECK_INTERVAL=18000000  # 5小时检查一次 (5 * 60 * 60 * 1000)
DB_STATUS_REPORT_INTERVAL=18000000 # 5小时报告一次状态
DB_TIMEZONE=+08:00

# JWT 密钥
JWT_SECRET=edit_my_degree_secret_key

# JWT Token过期时间配置
JWT_EXPIRES_IN=1h
SUPERADD_JWT_EXPIRES_IN=72h

# API签名密钥
API_SECRET_KEY=edit_my_degree_api_secret_key
VALID_APP_KEYS=sadwgfsefsdgfsdgf,asddsdoaiwd_asdlawnnn,zczxcvbnm123456

