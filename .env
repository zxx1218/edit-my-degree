# ============================================================================
# 应用基础配置
# ============================================================================
PORT=20000                                    # 后端服务器监听端口
VITE_API_BASE_URL="/api"                      # 前端请求的默认API前缀

# ============================================================================
# 数据库配置
# ============================================================================
# --- 生产环境数据库 ---
NODE_ENV=production                           # 运行环境: production | test | development
DB_HOST=localhost                             # 数据库主机地址
DB_USER=root                                  # 数据库用户名
DB_PASSWORD=991218aa                          # 数据库密码
DB_NAME=degree_management                     # 数据库名称
DB_PORT=3306                                  # 数据库端口
DB_TIMEZONE=+08:00                            # 数据库时区

# --- 测试环境数据库（注释状态）---
# NODE_ENV=test                               # 运行环境: production | test | development
# DB_HOST=localhost
# DB_USER=degree_management_test
# DB_PASSWORD=991218aa
# DB_NAME=degree_management_test
# DB_PORT=3306

# --- 数据库连接池配置 ---
DB_CONNECTION_LIMIT=10                        # 连接池最大连接数
DB_QUEUE_LIMIT=5                              # 等待队列限制
DB_WAIT_FOR_CONNECTIONS=true                  # 是否等待可用连接
DB_CONNECT_TIMEOUT=10000                      # 连接超时时间(毫秒)
DB_ACQUIRE_TIMEOUT=60000                      # 等待超时时间(毫秒)
DB_TIMEOUT=60000                              # 查询超时时间(毫秒)

# --- 数据库监控配置 ---
DB_HEALTH_CHECK_INTERVAL=18000000             # 健康检查间隔(毫秒), 5小时
DB_STATUS_REPORT_INTERVAL=18000000            # 状态报告间隔(毫秒), 5小时

# ============================================================================
# JWT 认证配置
# ============================================================================
JWT_SECRET=edit_my_degree_secret_key          # JWT签名密钥
JWT_EXPIRES_IN=2h                             # 普通用户Token过期时间(匹配最长永久卡用户)
SUPERADD_JWT_EXPIRES_IN=30d                   # 超级管理员Token过期时间

# ============================================================================
# API 安全配置
# ============================================================================
# --- API签名密钥 ---
API_SECRET_KEY=edit_my_degree_api_secret_key  # 后端API签名密钥
VITE_API_SECRET_KEY=edit_my_degree_api_secret_key  # 前端签名密钥(必须与API_SECRET_KEY一致)

# --- 应用标识白名单 ---
VITE_APP_KEY=sadwgfsefsdgfsdgf                # 前端应用身份标识
VALID_APP_KEYS=sadwgfsefsdgfsdgf,asddsdoaiwd_asdlawnnn,zczxcvbnm123456  # 合法应用标识白名单

# --- IP黑名单与频率限制 ---
IP_BLACKLIST=103.151.173.208,183.6.9.103,222.120.184.140,222.120.184.141,103.151.173.206,103.151.173.197  # 手动添加的黑名单IP(逗号分隔)

IP_RATE_LIMIT_WINDOW=300000                   # 频率检测时间窗口(毫秒), 默认5分钟
IP_RATE_LIMIT_MAX_REQUESTS=10                 # 时间窗口内最大请求次数,超过则封禁
IP_RATE_LIMIT_BLOCK_DURATION=604800000        # 自动封禁时长(毫秒), 默认7天
IP_RATE_LIMIT_CLEANUP_INTERVAL=3600000        # 缓存清理间隔(毫秒), 默认1小时

# ============================================================================
# 会话管理配置（单位：毫秒）
# ============================================================================
# 根据用户剩余登录次数动态设置会话时长

# 剩余登录次数 = 1 时的会话时长(5分钟)
VITE_SESSION_DURATION_LEVEL_1=300000
SESSION_DURATION_LEVEL_1=300000

# 剩余登录次数 > 1 且 <= 5 时的会话时长(20分钟)
VITE_SESSION_DURATION_LEVEL_2=1200000
SESSION_DURATION_LEVEL_2=1200000

# 剩余登录次数 > 5 且 <= 30 时的会话时长(30分钟)
VITE_SESSION_DURATION_LEVEL_3=1800000
SESSION_DURATION_LEVEL_3=1800000

# 剩余登录次数 > 30 时的会话时长(2小时)
VITE_SESSION_DURATION_LEVEL_4=7200000
SESSION_DURATION_LEVEL_4=7200000

# 默认会话时长(用于向后兼容,实际将根据用户剩余登录次数动态设置)
VITE_SESSION_DURATION=3600000                 # 前端默认值(60分钟)
SESSION_DURATION=3600000                      # 后端默认值(60分钟)

# ============================================================================
# 报告二维码与验证配置
# ============================================================================
VERIFICATION_BASE_URL=http://cheerout.cn:9092  # 二维码扫码后跳转验证界面的服务器URL

PDF_QR_CODE_MODE=available                    # PDF二维码生成模式: available(正常) | maintenance(维护)
QR_CODE_EXPIRES_IN_DAYS=2                     # 用户制作报告的二维码有效期限(单位:天)

# ============================================================================
# MinIO 对象存储配置
# ============================================================================
# 使用说明:
# 1. 设置mc别名: mc alias set minio http://127.0.0.1:19000 zxx 991218aa
# 2. 设置桶权限: mc anonymous set public myminio/editmydegree

MINIO_ENDPOINT=cheerout.cn:19000              # MinIO服务器地址(格式: 主机名:端口)
MINIO_BUCKET=editmydegree                     # 存储桶名称
MINIO_ACCESS_KEY=zxx                          # ⚠️ Access Key(请替换为实际值)
MINIO_SECRET_KEY=991218aa                     # ⚠️ Secret Key(请替换为实际值)
MINIO_USE_SSL=false                           # 是否使用SSL(true/false)

# ============================================================================
# 业务功能配置
# ============================================================================
# --- 购买页面配置 ---
VITE_CARD_LOGIN_URL=http://4ox.cn/bq3kuv      # 四云发卡网-登录卡密下单链接
VITE_CARD_PDF_URL=http://4ox.cn/sdms3r        # 四云发卡网-PDF下单链接
VITE_QQ_GROUP=1034981273                      # QQ群号

# --- 验证报告模块开关 ---
VITE_REPORT_IS_OPEN=true                      # true:正常显示 | false:显示报告售罄提示

# ============================================================================
# 日志配置
# ============================================================================
LOG_RETENTION_DAYS=3                          # 日志文件保留天数(单位:天)
