# ============================================================================
# 批量任务模块配置文件
# ============================================================================
# 说明: 此配置文件专用于 backend/batch_task 目录下的批量任务
# 注意: 与项目根目录的 .env 文件分开，便于独立管理

# ============================================================================
# 数据库配置（与主项目保持一致）
# ============================================================================
NODE_ENV=production                           # 运行环境: production | test | development
DB_HOST=localhost                             # 数据库主机地址
DB_USER=root                                  # 数据库用户名
DB_PASSWORD=991218aa                          # 数据库密码
DB_NAME=degree_management                     # 数据库名称
DB_PORT=3306                                  # 数据库端口
DB_TIMEZONE=+08:00                            # 数据库时区

# --- 数据库连接池配置 ---
DB_CONNECTION_LIMIT=5                         # 连接池最大连接数（批量任务可适当减小）
DB_QUEUE_LIMIT=3                              # 等待队列限制
DB_WAIT_FOR_CONNECTIONS=true                  # 是否等待可用连接
DB_CONNECT_TIMEOUT=10000                      # 连接超时时间(毫秒)
DB_ACQUIRE_TIMEOUT=60000                      # 等待超时时间(毫秒)
DB_TIMEOUT=60000                              # 查询超时时间(毫秒)

# ============================================================================
# IP地理位置更新任务配置
# ============================================================================
# updateIPLocation.js 任务参数

BATCH_SIZE=100                                # 每批处理的记录数
DELAY_BETWEEN_BATCHES=200                     # 批次间延迟（毫秒），避免API限流
DELAY_BETWEEN_IPS=50                          # 单个IP查询间的延迟（毫秒）

# ============================================================================
# 定时任务调度配置
# ============================================================================
# Cron表达式格式: 分 时 日 月 周
# 示例:
#   - 每天0:30执行: 30 0 * * *
#   - 每天12:30执行: 30 12 * * *
#   - 每天17:30执行: 30 17 * * *
#   - 每小时执行: 0 * * * *
#   - 每5分钟执行: */5 * * * *

# IP地理位置更新任务调度时间（每天三次）
UPDATE_IP_LOCATION_CRON_1=30 0 * * *          # 第一次执行: 凌晨0:30
UPDATE_IP_LOCATION_CRON_2=30 12 * * *         # 第二次执行: 中午12:30
UPDATE_IP_LOCATION_CRON_3=30 17 * * *         # 第三次执行: 下午17:30

# 时区设置（必须指定为中国时区）
CRON_TIMEZONE=Asia/Shanghai                   # 定时任务时区

# ============================================================================
# MinIO 对象存储配置（如果批量任务需要访问MinIO）
# ============================================================================
MINIO_ENDPOINT=cheerout.cn:19000              # MinIO服务器地址
MINIO_BUCKET=editmydegree                     # 存储桶名称
MINIO_ACCESS_KEY=zxx                          # ⚠️ Access Key
MINIO_SECRET_KEY=991218aa                     # ⚠️ Secret Key
MINIO_USE_SSL=false                           # 是否使用SSL

# ============================================================================
# 日志配置
# ============================================================================
LOG_RETENTION_DAYS=3                          # 日志文件保留天数
ENABLE_BATCH_TASK_LOG=true                    # 是否启用批量任务日志

# ============================================================================
# 其他API配置（根据任务需求添加）
# ============================================================================
# IP地理位置查询API密钥（如果需要）
# GAODE_API_KEY=your_gaode_api_key_here
# TAOBAO_API_KEY=your_taobao_api_key_here
